# FindMy Bridge Configuration

# Server Port
PORT=3000

# Optional Authentication Token / PIN (Leave blank for no authentication)
# Highly recommended when exposing via Tailscale Funnel or public URL!
AUTH_TOKEN=

# macOS Find My Cache Directory (Default: ~/Library/Caches/com.apple.findmy.fmipcore)
FINDMY_CACHE_DIR=

# Polling Interval (in milliseconds) to check for file updates
POLL_INTERVAL_MS=5000

# Enable automated AppleScript refresh on macOS to keep location cache fresh
ENABLE_MAC_REFRESH=true
REFRESH_INTERVAL_MINUTES=5

# Set to true to use mock/sample data for testing
MOCK_DATA=false
